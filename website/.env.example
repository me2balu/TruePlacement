# Copy this file to .env and fill in what you have.
# The site works without any keys — text scanning is 100% client-side.
# The two keys below only power the "Verify this opening" AI feature.

PORT=3000

# Optional — powers the web-search step of "Verify this opening".
# Get a free-tier key at https://serpapi.com. If left blank, the server
# falls back to an unauthenticated DuckDuckGo HTML search (works, but
# lower quality and easier to rate-limit).
SERPAPI_KEY=b07e68eeeb332c68f2f0f53dbb2101b143fe4e31ebd339d6c98bab701749494d

# Optional — powers the AI reasoning step that reads the search results
# and writes the verdict + explanation. Get a key at https://console.anthropic.com.
# If left blank, "Verify this opening" still runs the search and shows the
# raw evidence, plus a simple heuristic verdict, just without the written
# explanation.
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Which Claude model to call for the AI reasoning step. Check
# https://docs.claude.com for the current recommended model string if this
# stops working — model names change over time.
CLAUDE_MODEL=claude-sonnet-5
